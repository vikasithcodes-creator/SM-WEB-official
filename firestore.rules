rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins registry: only existing admins can read/write
    match /admins/{adminUid} {
      allow get, list: if isAdmin();
      allow write: if isAdmin() && isValidId(adminUid);
    }

    // Users collection: private user profile, owner only or admin
    match /users/{userId} {
      allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId)
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.role == 'customer';
      allow update: if isOwner(userId) && isValidId(userId)
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.role == resource.data.role; // Prevent self-elevation to admin
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Products collection: public read, admin-only write
    match /products/{productId} {
      allow get, list: if true;
      allow write: if isAdmin() && isValidId(productId);
    }

    // Orders collection:
    // Authenticated customer can read/list their own orders.
    // Admin can read, list, create, update, and delete all orders.
    // Guest orders are mediated via secure backend endpoints to guarantee phone-number verification.
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(orderId) && (isAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid));
      allow update, delete: if isAdmin() && isValidId(orderId);
    }
  }
}
