{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role indicator (customer or admin).",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "phone": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Admin authorization entry indexed by auth UID.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "addedAt": { "type": "string" }
      },
      "required": ["email", "addedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Catalog 3D printed figurine or god idol product.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "available": { "type": "boolean" },
        "featured": { "type": "boolean" }
      },
      "required": ["id", "name", "category", "price", "description", "available"]
    },
    "Order": {
      "title": "Order",
      "description": "3D print dispatch order with customer info, tracking ID, quotation, and status timeline.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "trackingId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "customerName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "postalCode": { "type": "string" },
        "userId": { "type": "string" },
        "priorityQueue": { "type": "string", "enum": ["standard", "rush"] },
        "orderType": { "type": "string" },
        "hasCustomJob": { "type": "boolean" },
        "quantity": { "type": "number" },
        "quoteAmount": { "type": "number" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "shipping": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "trackingId", "createdAt", "customerName", "phone", "total", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Private user account profile."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Authorized admin users lookup list for RBAC."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Public storefront products catalog."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer 3D print orders. Admin manages all; authenticated users read/create own orders. Public/guest order tracking and confirmation is securely mediated via server-side verification with phone number check."
    }
  }
}
