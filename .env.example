# Copy to .env for local development. Never commit real values.

# Required in production: password for the admin panel's password login.
ADMIN_PASSWORD="change-me"

# Optional: only needed if the Gemini-powered /api/chat endpoint is used.
# The live chatbot is the client-side FAQ assistant and does not need it.
GEMINI_API_KEY=""

# Set automatically by Cloud Run; defaults to 3000 locally.
# PORT=3000
